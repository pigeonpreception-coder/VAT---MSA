{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.vat-msa.na/invoice/1.0.0",
  "title": "VAT-MSA Canonical Invoice",
  "description": "Canonical fiscal-document submission contract. Tax classifications and mandatory particulars remain subject to NamRA legal approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_type",
    "source",
    "supplier",
    "customer",
    "invoice_number",
    "issue_date",
    "currency",
    "lines",
    "totals"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "document_type": {
      "type": "string",
      "enum": ["TAX_INVOICE", "SIMPLIFIED_TAX_INVOICE", "CREDIT_NOTE", "DEBIT_NOTE", "SELF_BILLED_INVOICE"]
    },
    "source": { "$ref": "#/$defs/source" },
    "supplier": { "$ref": "#/$defs/party" },
    "customer": { "$ref": "#/$defs/party" },
    "invoice_number": { "type": "string", "minLength": 1, "maxLength": 100 },
    "issue_date": { "type": "string", "format": "date" },
    "issue_time": { "type": "string", "format": "time" },
    "tax_point_date": { "type": "string", "format": "date" },
    "due_date": { "type": "string", "format": "date" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "default": "NAD" },
    "exchange_rate": { "$ref": "#/$defs/nonNegativeDecimal" },
    "purchase_order_reference": { "type": "string", "maxLength": 100 },
    "contract_reference": { "type": "string", "maxLength": 100 },
    "original_document_reference": {
      "description": "Required for credit notes, debit notes and approved reversals.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source_document_id"],
      "properties": {
        "source_document_id": { "type": "string", "maxLength": 150 },
        "vat_msa_invoice_id": { "type": "string", "format": "uuid" },
        "reason_code": { "type": "string", "maxLength": 50 },
        "reason": { "type": "string", "maxLength": 500 }
      }
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/line" }
    },
    "allowances_charges": {
      "type": "array",
      "items": { "$ref": "#/$defs/allowanceCharge" }
    },
    "totals": { "$ref": "#/$defs/totals" },
    "payment": { "$ref": "#/$defs/payment" },
    "notes": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "maxLength": 1000 }
    },
    "extensions": {
      "description": "Namespaced partner extensions. Fiscal calculations may not depend on unapproved extensions.",
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "document_type": { "enum": ["CREDIT_NOTE", "DEBIT_NOTE"] } },
        "required": ["document_type"]
      },
      "then": { "required": ["original_document_reference"] }
    }
  ],
  "$defs": {
    "amount": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,15})(\\.[0-9]{1,6})?$",
      "description": "Decimal string; never a binary floating-point number."
    },
    "nonNegativeDecimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,8})?$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_id", "document_id", "submitted_at"],
      "properties": {
        "system_id": { "type": "string", "minLength": 1, "maxLength": 100 },
        "device_id": { "type": "string", "maxLength": 100 },
        "document_id": { "type": "string", "minLength": 1, "maxLength": 150 },
        "submitted_at": { "type": "string", "format": "date-time" },
        "offline_sequence": { "type": "string", "maxLength": 150 }
      }
    },
    "identifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "type": "string", "enum": ["VAT_NUMBER", "TIN", "COMPANY_NUMBER", "NATIONAL_ID", "PASSPORT", "OTHER"] },
        "value": { "type": "string", "minLength": 1, "maxLength": 100 },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$" }
      }
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "line1": { "type": "string", "maxLength": 200 },
        "line2": { "type": "string", "maxLength": 200 },
        "city": { "type": "string", "maxLength": 100 },
        "region": { "type": "string", "maxLength": 100 },
        "postal_code": { "type": "string", "maxLength": 30 },
        "country": { "type": "string", "pattern": "^[A-Z]{2}$", "default": "NA" }
      }
    },
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "identifiers"],
      "properties": {
        "vat_msa_taxpayer_id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 250 },
        "trading_name": { "type": "string", "maxLength": 250 },
        "identifiers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/identifier" }
        },
        "address": { "$ref": "#/$defs/address" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "phone": { "type": "string", "maxLength": 40 }
      }
    },
    "tax": {
      "type": "object",
      "additionalProperties": false,
      "required": ["category", "rate", "taxable_amount", "tax_amount"],
      "properties": {
        "category": {
          "type": "string",
          "enum": ["STANDARD", "ZERO_RATED", "EXEMPT", "OUTSIDE_SCOPE", "REVERSE_CHARGE", "OTHER"]
        },
        "rate": { "$ref": "#/$defs/nonNegativeDecimal" },
        "taxable_amount": { "$ref": "#/$defs/amount" },
        "tax_amount": { "$ref": "#/$defs/amount" },
        "exemption_reason_code": { "type": "string", "maxLength": 50 },
        "rule_reference": { "type": "string", "maxLength": 100 }
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line_number", "description", "quantity", "unit_code", "unit_price", "net_amount", "tax"],
      "properties": {
        "line_number": { "type": "integer", "minimum": 1 },
        "item_code": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "quantity": { "$ref": "#/$defs/nonNegativeDecimal" },
        "unit_code": { "type": "string", "minLength": 1, "maxLength": 20 },
        "unit_price": { "$ref": "#/$defs/amount" },
        "gross_amount": { "$ref": "#/$defs/amount" },
        "discount_amount": { "$ref": "#/$defs/amount" },
        "net_amount": { "$ref": "#/$defs/amount" },
        "tax": { "$ref": "#/$defs/tax" },
        "classification": { "type": "string", "maxLength": 100 },
        "country_of_origin": { "type": "string", "pattern": "^[A-Z]{2}$" }
      }
    },
    "allowanceCharge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "amount"],
      "properties": {
        "type": { "type": "string", "enum": ["ALLOWANCE", "CHARGE"] },
        "reason_code": { "type": "string", "maxLength": 50 },
        "reason": { "type": "string", "maxLength": 500 },
        "amount": { "$ref": "#/$defs/amount" },
        "tax": { "$ref": "#/$defs/tax" }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line_net_amount", "tax_exclusive_amount", "tax_amount", "tax_inclusive_amount", "payable_amount"],
      "properties": {
        "line_net_amount": { "$ref": "#/$defs/amount" },
        "allowance_total_amount": { "$ref": "#/$defs/amount" },
        "charge_total_amount": { "$ref": "#/$defs/amount" },
        "tax_exclusive_amount": { "$ref": "#/$defs/amount" },
        "tax_amount": { "$ref": "#/$defs/amount" },
        "tax_inclusive_amount": { "$ref": "#/$defs/amount" },
        "prepaid_amount": { "$ref": "#/$defs/amount" },
        "rounding_amount": { "$ref": "#/$defs/amount" },
        "payable_amount": { "$ref": "#/$defs/amount" },
        "tax_breakdown": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/tax" }
        }
      }
    },
    "payment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "means_code": { "type": "string", "maxLength": 50 },
        "reference": { "type": "string", "maxLength": 100 },
        "account_reference": { "type": "string", "maxLength": 100 },
        "terms": { "type": "string", "maxLength": 500 }
      }
    }
  }
}

