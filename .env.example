# Production accepts identity headers only behind the authenticated Sites dispatch boundary.
VAT_MSA_IDENTITY_TRUST_MODE=SITES_DISPATCH

# Supply through the deployment secret store; use at least 32 random characters.
VAT_MSA_STEP_UP_HMAC_SECRET=

# Exact trusted identity-broker issuer for signed privileged-change evidence.
VAT_MSA_STEP_UP_ISSUER=

# Deployment classification used to keep synthetic counterparty evidence out of production.
VAT_MSA_ENVIRONMENT=local

# Staging-only explicit switch; ignored when VAT_MSA_ENVIRONMENT=production.
VAT_MSA_ENABLE_SYNTHETIC_COUNTERPARTY_TRUST=false

# Staging-only explicit switch for synthetic authority-governance commands.
# Production authority activation and live federation remain unavailable.
VAT_MSA_ENABLE_SYNTHETIC_AUTHORITY_GOVERNANCE=false

# Optional OpenAI Responses API integration for governed analytics model runs.
# Leave deterministic unless a deployment has an approved API key and model entitlement.
VAT_MSA_ANALYTICS_MODEL_PROVIDER=deterministic
VAT_MSA_OPENAI_MODEL=gpt-5.6-sol
VAT_MSA_OPENAI_REASONING_EFFORT=low
VAT_MSA_OPENAI_BASE_URL=https://api.openai.com/v1
VAT_MSA_OPENAI_TIMEOUT_MS=30000
OPENAI_API_KEY=
