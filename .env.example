# Production accepts identity headers only behind the authenticated Sites dispatch boundary.
VAT_MSA_IDENTITY_TRUST_MODE=SITES_DISPATCH

# Supply through the deployment secret store; use at least 32 random characters.
VAT_MSA_STEP_UP_HMAC_SECRET=

# Exact trusted identity-broker issuer for signed privileged-change evidence.
VAT_MSA_STEP_UP_ISSUER=
